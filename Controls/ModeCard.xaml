<UserControl x:Class="SmartLauncher.UI.Controls.ModeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="255"
             Width="280"
             Height="300"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Opacity="0"
             Loaded="UserControl_Loaded"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">

    <UserControl.Resources>
        <Style x:Key="CardButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="42"/>
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.66"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="32"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Background"
                    Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="IconBorder"
                                        Property="Background"
                                        Value="#2B416F"/>
                                <Setter TargetName="IconBorder"
                                        Property="BorderBrush"
                                        Value="#4E78C8"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="IconBorder"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardContextMenu"
               TargetType="ContextMenu">
            <Setter Property="Background"
                    Value="#1D212B"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#353C4B"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardMenuItem"
               TargetType="MenuItem">
            <Setter Property="Padding"
                    Value="14,9"/>
            <Setter Property="Margin"
                    Value="2"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="MinWidth"
                    Value="190"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="MenuItemBorder"
                                        Property="Background"
                                        Value="#2B416F"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="MenuItemBorder"
                                        Property="Background"
                                        Value="#36548D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardMenuSeparator"
               TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="12,5"
                                Background="#3A4252"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScaleTransform"
                                ScaleX="0.96"
                                ScaleY="0.96"/>
                <TranslateTransform x:Name="CardTranslateTransform"
                                    Y="18"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="CardBorder"
                Padding="18"
                CornerRadius="22"
                BorderThickness="1.2">
            <Border.Background>
                <SolidColorBrush x:Name="CardBackgroundBrush"
                                 Color="#171717"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush x:Name="CardBorderBrush"
                                 Color="#2C2C2C"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadowEffect"
                                  Color="#000000"
                                  BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.22"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Width="64"
                        Height="3"
                        Margin="0,-9,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        CornerRadius="2"
                        Background="{Binding AccentColor}"/>

                <Grid Grid.Row="0">
                    <Border Width="60"
                            Height="60"
                            CornerRadius="17"
                            HorizontalAlignment="Center"
                            Background="#101217"
                            BorderBrush="{Binding AccentColor}"
                            BorderThickness="1"
                            Padding="7">
                        <Image Source="{Binding Icon}"
                               Stretch="Uniform"/>
                    </Border>

                    <Button x:Name="MoreButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource IconButton}"
                            FontSize="18"
                            Content="⋯"
                            Click="MoreButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource CardContextMenu}">
                                <MenuItem Header="Редактировать"
                                          Style="{StaticResource CardMenuItem}"
                                          Click="EditMenuItem_Click"/>
                                <MenuItem Header="Дублировать"
                                          Style="{StaticResource CardMenuItem}"
                                          Click="DuplicateMenuItem_Click"/>
                                <Separator Style="{StaticResource CardMenuSeparator}"/>
                                <MenuItem Header="Удалить"
                                          Style="{StaticResource CardMenuItem}"
                                          Click="DeleteMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Name}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="19"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,13,0,5"/>

                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Description}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxHeight="38"/>
                    <TextBlock x:Name="TargetsText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <TextBlock x:Name="RuntimeStatusText"
                           Grid.Row="3"
                           Text="Готов к запуску"
                           Foreground="#62D49A"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <Grid Grid.Row="4">
                    <Button x:Name="LaunchButton"
                            Content="▶  Запустить"
                            Background="{Binding AccentColor}"
                            Style="{StaticResource CardButton}"
                            Click="LaunchButton_Click"/>

                    <Button x:Name="StopButton"
                            Content="■  Остановить"
                            Background="#C23A4B"
                            Style="{StaticResource CardButton}"
                            Visibility="Collapsed"
                            Click="StopButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
