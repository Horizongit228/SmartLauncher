<Window x:Class="SmartLauncher.UI.Dialogs.AddApplicationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить приложение"
        Width="560"
        Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#12151C"
        Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Новое приложение"
                   FontSize="26"
                   FontWeight="Bold"/>
        <TextBlock Grid.Row="1"
                   Text="Добавьте программу, которой нет в автоматическом каталоге."
                   Foreground="#9AA4B7"
                   Margin="0,6,0,18"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Название" Foreground="#AAB2C2"/>
            <TextBox x:Name="NameBox"
                     Height="38"
                     Padding="10,7"
                     Margin="0,5,0,12"
                     Background="#202633"
                     Foreground="White"
                     BorderBrush="#343D50"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Исполняемый файл (.exe)" Foreground="#AAB2C2"/>
                <TextBox x:Name="PathBox"
                         Height="38"
                         Padding="10,7"
                         Margin="0,5,8,12"
                         Background="#202633"
                         Foreground="White"
                         BorderBrush="#343D50"
                         TextChanged="PathBox_TextChanged"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Обзор"
                    Height="38"
                    MinWidth="84"
                    Margin="0,24,0,12"
                    Click="BrowseButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Категория" Foreground="#AAB2C2"/>
            <ComboBox x:Name="CategoryBox"
                      Height="38"
                      Margin="0,5,0,0"
                      Padding="8,5"
                      Background="#202633"
                      Foreground="White"
                      BorderBrush="#343D50"/>
            <TextBlock x:Name="ValidationText"
                       Foreground="#FF8C9B"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Отмена"
                    MinWidth="92"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Добавить"
                    MinWidth="105"
                    IsDefault="True"
                    Click="AddButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
