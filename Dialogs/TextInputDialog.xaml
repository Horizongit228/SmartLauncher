<Window x:Class="SmartLauncher.UI.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Launcher"
        Width="440"
        Height="225"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#12151C"
        Foreground="White">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        <TextBox x:Name="ValueBox"
                 Grid.Row="1"
                 Height="40"
                 Margin="0,14,0,0"
                 Padding="10,7"
                 Background="#202633"
                 Foreground="White"
                 BorderBrush="#343D50"/>
        <TextBlock x:Name="ValidationText"
                   Grid.Row="2"
                   Foreground="#FF8C9B"
                   Margin="0,8,0,0"/>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Отмена"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Сохранить"
                    MinWidth="100"
                    IsDefault="True"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
